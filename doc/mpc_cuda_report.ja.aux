\@writefile{toc}{\contentsline {paragraph}{全経路の交差（H100）}{10}{section*.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 実数 AXPY の時間 vs 精度（両対数）。実線＝H100（65536 ビットまで），破線＝GB10（8192 ビットまで）。青＝\texttt  {cu\_freal}，橙＝\texttt  {cu\_mpfr}，緑＝CPU。固定精度は 1024 ビットまで一定で，2048 ビットでスピルにより跳ね上がり，H100 では8192 ビットで cu\_mpfr と，16384 ビットで CPU と交差し，以降急激に最悪化する。}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:real}{{2}{11}{実数 AXPY の時間 vs 精度（両対数）。実線＝H100（65536 ビットまで），破線＝GB10（8192 ビットまで）。青＝\code {cu\_freal}，橙＝\code {cu\_mpfr}，緑＝CPU。固定精度は 1024 ビットまで一定で，2048 ビットでスピルにより跳ね上がり，H100 では8192 ビットで cu\_mpfr と，16384 ビットで CPU と交差し，以降急激に最悪化する。}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}CPU 上での固定精度パス}{11}{subsection.5.5}\protected@file@percent }
