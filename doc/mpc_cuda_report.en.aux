\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Complex AXPY time vs precision (log-log); series as in Figure~\ref {fig:real}. Same shape with a larger fixed-precision lead, but on the H100 \texttt  {cu\_fcomplex} crosses \texttt  {cu\_mpc} at 16384 bits and the CPU before 32768 bits.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:complex}{{3}{13}{Complex AXPY time vs precision (log-log); series as in Figure~\ref {fig:real}. Same shape with a larger fixed-precision lead, but on the H100 \code {cu\_fcomplex} crosses \code {cu\_mpc} at 16384 bits and the CPU before 32768 bits}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Cross-platform comparison: GB10 vs H100 (synthesis)}{13}{subsection.5.7}\protected@file@percent }
