\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces GPU fixed-precision speedup vs precision (log-log, $y=1$ is parity). Solid = H100, dashed = GB10. (a) real (vs CPU and vs cu\_mpfr); (b) complex (vs CPU and vs cu\_mpc). Peak at 1024 bits, spill knee at 2048 bits, and $y<1$ at high precision where fixed precision loses.}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:speedup}{{4}{14}{GPU fixed-precision speedup vs precision (log-log, $y=1$ is parity). Solid = H100, dashed = GB10. (a) real (vs CPU and vs cu\_mpfr); (b) complex (vs CPU and vs cu\_mpc). Peak at 1024 bits, spill knee at 2048 bits, and $y<1$ at high precision where fixed precision loses}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces CPU-only fixed precision vs system MPFR/MPC (AXPY, N=4096, single thread; ratio $>1$ means fixed precision is faster)}}{14}{table.7}\protected@file@percent }
