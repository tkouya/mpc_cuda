\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Precision sweep on the H100 (AXPY, N=4096, all bit-exact). GB10 is not re-measurable here, so see Table~\ref {tab:bench3} for GB10 to 8192 bits. Times in ms (8-iteration average).}}{11}{table.6}\protected@file@percent }
\newlabel{tab:bench3h100}{{6}{11}{Precision sweep on the H100 (AXPY, N=4096, all bit-exact). GB10 is not re-measurable here, so see Table~\ref {tab:bench3} for GB10 to 8192 bits. Times in ms (8-iteration average)}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Real AXPY time vs precision (log-log). Solid = H100 (to 65536 bits), dashed = GB10 (to 8192 bits); blue = \texttt  {cu\_freal}, orange = \texttt  {cu\_mpfr}, green = CPU. Fixed precision is flat through 1024 bits, jumps at 2048 (spill), and on the H100 crosses \texttt  {cu\_mpfr} at 8192 bits and the CPU at 16384 bits, then diverges sharply.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:real}{{2}{12}{Real AXPY time vs precision (log-log). Solid = H100 (to 65536 bits), dashed = GB10 (to 8192 bits); blue = \code {cu\_freal}, orange = \code {cu\_mpfr}, green = CPU. Fixed precision is flat through 1024 bits, jumps at 2048 (spill), and on the H100 crosses \code {cu\_mpfr} at 8192 bits and the CPU at 16384 bits, then diverges sharply}{figure.2}{}}
